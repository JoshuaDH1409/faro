# Puerto local
PORT=3000

# Clave de API de Gemini (opcional para inferencia en vivo con LLM)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# URL de Base de Datos para sincronización de métricas
DATABASE_URL=postgresql://usuario:password@host:5432/faro_db

# Stripe (opcional). El cobro funciona hoy con el Payment Link, sin estas variables.
# Con ambas definidas se activa POST /api/v1/billing/webhook.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
