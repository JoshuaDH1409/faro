# Puerto local
PORT=3000

# Clave de API de Gemini (opcional para inferencia en vivo con LLM)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Postgres para leads y suscripciones (en Vercel también sirve POSTGRES_URL)
DATABASE_URL=postgresql://usuario:password@host:5432/faro_db

# Stripe (opcional). El cobro funciona con el Payment Link sin estas variables.
# Con el signing secret se activa POST /api/v1/billing/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx
