# Puerto local
PORT=3000

# Clave de API de Gemini (opcional para inferencia en vivo con LLM)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Postgres para leads y suscripciones (en Vercel también sirve POSTGRES_URL)
DATABASE_URL=postgresql://usuario:password@host:5432/faro_db

# Stripe (opcional). El cobro funciona con el Payment Link sin estas variables.
# Con el signing secret se activa POST /api/v1/billing/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Correos del recordatorio semanal.
# Preferido: Gmail SMTP (contraseña de aplicación de faro.reportes@gmail.com).
GMAIL_USER=faro.reportes@gmail.com
GMAIL_APP_PASSWORD=
FARO_FROM_EMAIL=Joshua Díaz | Faro <faro.reportes@gmail.com>
FARO_APP_URL=https://faro-jadh.vercel.app
# Opcional: Resend si existe RESEND_API_KEY (se usa solo si Gmail no está configurado).
RESEND_API_KEY=
# Tope diario de recordatorios del cron (~80).
FARO_MAIL_DAILY_CAP=80
# Opcional: autoriza una llamada manual al cron (Authorization: Bearer ...)
CRON_SECRET=
